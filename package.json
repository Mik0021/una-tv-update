{
  "name": "unatvbih",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run unatvbih:serve-ssr",
    "serve:ssr": "node dist/server/main.js",
    "build:ssrsrb": "ng build --configuration=unasr --aot && ng run unatvbih:server:unasr",
    "build:ssrsrbprod": "ng build --configuration=unasrprod --aot && ng run unatvbih:server:unasrprod",
    "prerender": "ng run unatvbih:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "~19.2.25",
    "@angular/compiler": "~19.2.25",
    "@angular/core": "~19.2.25",
    "@angular/forms": "~19.2.25",
    "@angular/platform-browser": "~19.2.25",
    "@angular/platform-browser-dynamic": "~19.2.25",
    "@angular/platform-server": "~19.2.25",
    "@angular/router": "~19.2.25",
    "@angular/ssr": "^19.2.27",
    "express": "^4.15.2",
    "ng-recaptcha-2": "^15.0.3",
    "ng2-adsense": "^14.0.0",
    "ngx-pagination": "^6.0.3",
    "ngx-sharebuttons": "^17.0.0",
    "rxjs": "~7.5.6",
    "swiper": "^11.2.10",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.4.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.2.27",
    "@angular/cli": "~19.2.27",
    "@angular/compiler-cli": "~19.2.25",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.130",
    "browser-sync": "^3.0.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "postcss": "^8.4.16",
    "typescript": "~5.8.3"
  }
}
